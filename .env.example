# venapce-api configuration. Copy to .env for local dev.

# HTTP port the API listens on.
PORT=8080

# Postgres (the shared venapce database from deploy/postgres-init).
# Local dev against the deploy compose Postgres published on 127.0.0.1:5432:
DATABASE_URL=postgres://venapce:venapce@localhost:5432/venapce?sslmode=disable

# Key material used to encrypt stored secrets (the Superset password). Set a long
# random value in production — rotating it invalidates the stored password.
APP_SECRET_KEY=dev-insecure-change-me

# Browser origin(s) allowed to call this API (the Vue front).
CORS_ORIGINS=http://localhost:5173

# FloMorphic API access. Venapce runs as a FloMorphic plugin: instead of pasting a
# plugin env, the backend calls the FloMorphic API to mint its own runtime
# credential (POST /extension/plugin/cred) and receives the ready-to-use plugin
# env. FLOMORPHIC_URL is the FloMorphic API base; FLOMORPHIC_JWT_SECRET is the
# HS256 secret the backend signs an admin bearer token with (must match
# FloMorphic's API_JWT_SECRET / INFLOW_INFRA_JWT_SECRET). Both are required for the
# "Connect FloMorphic" action in Settings.
# FLOMORPHIC_URL=http://localhost:3000
# FLOMORPHIC_JWT_SECRET=change-me-shared-with-flomorphic

# Hostname of the infra service. Venapce uses it for BOTH infra ports: the plugin
# connects to NATS on :4222, and osctrl-space requests hit the osspace HTTP API on
# :8022 (same host). It is passed as INFRA_URL when minting the plugin credential,
# so the minted env points at the host venapce can actually reach.
#   - deploy compose: the infra container name (default below)
#   - local dev: the host you reach infra on, e.g. localhost or a LAN/bridge IP
INFRA_HOST=infra

# Built-in Superset connection (optional). When all three are set, the backend
# auto-configures the Superset connection on boot from these — the operator never
# types Superset credentials in Settings, and the Settings card shows a read-only
# status accordion. In the deploy compose these mirror the admin the superset
# service is bootstrapped with. Leave unset for the manual Settings flow (host
# dev), or to let an operator point Venapce at an external Superset.
# SUPERSET_URL=http://superset:8088
# SUPERSET_ADMIN_USER=admin
# SUPERSET_ADMIN_PASS=admin

# Superset provisioning (lazy, on boot): register this Postgres as a Superset
# database connection and add the data tables (stage, issues) as datasets.
#
# By default the connection details are taken from DATABASE_URL above. BUT Superset
# reaches Postgres over ITS OWN network, so `localhost` here means the Superset
# container itself — not this host. When Superset runs in a container you MUST
# point it at a host it can actually reach, otherwise it connects to the wrong
# Postgres and you'll see "password incorrect for username ...".
#   - Superset in Docker, Postgres on this host:  SUPERSET_DB_HOST=host.docker.internal
#     (on Linux this also needs `extra_hosts: ["host.docker.internal:host-gateway"]`
#      on the Superset service, or use the host's LAN/bridge IP)
#   - Everything in the deploy compose:  SUPERSET_DB_HOST=postgres, and the venapce
#     database there uses user `venapce` (SUPERSET_DB_USER=venapce, SUPERSET_DB_PASSWORD=...)
SUPERSET_DB_NAME=Venapce
SUPERSET_SCHEMA=public
# SUPERSET_DB_HOST=host.docker.internal
# SUPERSET_DB_PORT=5432
# SUPERSET_DB_DATABASE=venapce
# SUPERSET_DB_USER=postgres
# SUPERSET_DB_PASSWORD=db-pass-321
# SUPERSET_DB_SSLMODE=disable
